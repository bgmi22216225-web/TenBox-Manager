# --- Telegram credentials (from my.telegram.org) ---
API_ID=
API_HASH=

# --- Set ONE of these ---
BOT_TOKEN=
SESSION_STRING=

# --- Neon PostgreSQL connection string ---
# Example: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Channels / secondary bot ---
SOURCE_CHANNEL_ID=
DESTINATION_CHANNEL_ID=
SECONDARY_BOT_USERNAME=

# --- Access control ---
# Comma-separated Telegram user IDs, e.g. 123456789,987654321
ADMIN_IDS=

# --- Optional tunables ---
SECONDARY_BOT_TIMEOUT=90
LINK_FILTER_KEYWORD=tenbox
TEMP_DIR=/tmp/v_bot
